	measure 'Units Market Total' =
			CALCULATE (
			    [Units],
			    REMOVEFILTERS ( Products ),
			    REMOVEFILTERS ( 'International Products' ),
			    REMOVEFILTERS ( 'International Packs' ),
			    REMOVEFILTERS ( Molecules ),
			    REMOVEFILTERS ( 'Generic Product Classification' ),
			    REMOVEFILTERS ( Corporations ),
			    REMOVEFILTERS ( 'Current Protection' ),
			    REMOVEFILTERS ( Prescriptions )
			)
		formatString: #,0;-#,0;0
		isHidden
		displayFolder: Technical
		lineageTag: 1b6f0d65-37d6-4f21-bef7-92649dfd46ee

