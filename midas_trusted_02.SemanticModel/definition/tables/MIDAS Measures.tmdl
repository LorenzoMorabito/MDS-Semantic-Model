	measure 'Units EI' =
			VAR CurrentShare = [Units MS%]
			VAR PreviousShare = CALCULATE ( [Units MS%], DATEADD ( Time[QUARTER_ID], -1, YEAR ) )
			RETURN
			    IF ( ISBLANK ( PreviousShare ), BLANK (), DIVIDE ( CurrentShare, PreviousShare ) * 100 )
		formatString: 0.0;-0.0;0.0
		displayFolder: 'Evolution Index'
		lineageTag: 0260071f-285f-4ea9-a846-cdeb2c9310be

