	measure 'Units CUM' =
			VAR CurrentQuarter = MAX ( Time[QUARTER_ID] )
			VAR CurrentYear = MAX ( Time[YEAR] )
			RETURN
			    CALCULATE (
			        [Units],
			        FILTER ( ALL ( Time[QUARTER_ID], Time[YEAR] ), Time[YEAR] = CurrentYear && Time[QUARTER_ID] <= CurrentQuarter )
			    )
		formatString: #,0;-#,0;0
		displayFolder: CUM
		lineageTag: 1e8feb6c-96d3-4e18-b259-327e4a0bd7fe

