	measure 'Units Delta % vs PY' =
			VAR PriorYear = CALCULATE ( [Units], DATEADD ( d_time[QUARTER_ID], -1, YEAR ) )
			RETURN
			    DIVIDE ( [Units] - PriorYear, PriorYear )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 'Delta vs PY'
		lineageTag: c8129651-11ff-4ea6-bf7f-8d656c4ef2f6

