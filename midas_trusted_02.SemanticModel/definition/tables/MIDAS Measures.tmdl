	measure 'Units CUM' =
			VAR CurrentQuarter = MAX ( d_time[QUARTER_ID] )
			VAR CurrentYear = MAX ( d_time[YEAR] )
			RETURN
			    CALCULATE (
			        [Units],
			        FILTER ( ALL ( d_time[QUARTER_ID], d_time[YEAR] ), d_time[YEAR] = CurrentYear && d_time[QUARTER_ID] <= CurrentQuarter )
			    )
		formatString: #,0;-#,0;0
		displayFolder: Cumulative
		lineageTag: 1e8feb6c-96d3-4e18-b259-327e4a0bd7fe

