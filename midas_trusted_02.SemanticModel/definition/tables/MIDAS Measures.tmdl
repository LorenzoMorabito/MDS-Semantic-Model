			RETURN
			    IF ( ISBLANK ( PreviousShare ), BLANK (), DIVIDE ( CurrentShare, PreviousShare ) * 100 )
		formatString: 0.0;-0.0;0.0
		displayFolder: 'Evolution Index'
		lineageTag: 0e67eec6-cbb0-4ecb-9dbd-ce03efb34d62

	column Column
		isHidden
		formatString: 0
		lineageTag: 05e8d702-cc7d-44e5-aed2-c73370d286d8
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition 'MIDAS Measures' = calculated
		mode: import
		source = Row("Column", BLANK())



